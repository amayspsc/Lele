{
  "name": "lelepakabi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cloudflare:dev": "npm run build && wrangler dev --ip 0.0.0.0 --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply lelepakabi --local",
    "db:migrate:remote": "wrangler d1 migrations apply lelepakabi --remote"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
